# Copy these into your hosting provider's secret/environment-variable settings.
# Never commit real values to Git or share BOT_TOKEN/API_HASH.
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=your_telegram_numeric_user_id
DATA_DIR=/app/data
# Optional: DB_PATH=/app/data/bot.sqlite3
